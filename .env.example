GROQ_API_KEY=your_key_here
GROQ_MODEL=llama-3.3-70b-versatile
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
USE_YT_CAPTIONS=true
MAX_VIDEO_MINUTES=60

# YouTube/network resilience
YT_SOCKET_TIMEOUT=12
YT_RETRIES=2
YT_FRAGMENT_RETRIES=2
YT_EXTRACTOR_RETRIES=2
CAPTION_TIMEOUT=10
MAX_PLAYLIST_VIDEOS=10

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=64
QDRANT_UPSERT_BATCH_SIZE=64
QDRANT_PATH=data/qdrant
CHUNK_SECONDS=75
TOP_K=3
CHAPTER_MINUTES=6
QUIZ_QUESTIONS=5
SHARED_LIBRARY=true
LOG_LEVEL=INFO

# Student experience
NORMALIZE_HINGLISH=true

# Streaming / background processing
STREAM_WHISPER=true
STREAM_FIRST_WINDOW_SECONDS=90
STREAM_WINDOW_SECONDS=180
CAPTION_SLICE_SECONDS=900
JOB_WORKERS=2
LIBRARY_CACHE_SECONDS=10

# Playlists
PLAYLIST_PREVIEW_LIMIT=25
PLAYLIST_SEARCH_RESULTS=6
